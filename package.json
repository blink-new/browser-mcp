{
  "name": "@anthropic-tools/browser-mcp",
  "version": "1.0.0",
  "description": "A Model Context Protocol (MCP) server for browser automation using Puppeteer. Enables AI assistants to navigate web pages, take screenshots, click elements, fill forms, and interact with web content.",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "browser-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "prepare": "npm run build",
    "test": "echo \"No tests yet\" && exit 0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "browser",
    "puppeteer",
    "automation",
    "web-scraping",
    "ai",
    "anthropic",
    "claude",
    "openai",
    "llm"
  ],
  "author": "blink-new",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blink-new/browser-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/blink-new/browser-mcp/issues"
  },
  "homepage": "https://github.com/blink-new/browser-mcp#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "puppeteer": "^23.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
